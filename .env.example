# API server configuration. Values shown are the dev cluster's (dev/setup.sh):
# Dex behind the ingress at http://auth.dploy.localhost/dex.
#
# This file configures the API only. The operator takes no environment
# configuration — its defaults (base domain, TTLs, quota, Flux settings) live in
# the cluster-scoped OperatorConfig singleton, and the catalog lives in
# DployTemplate resources.

# JWT validation (required — the API refuses to start without these)
JWKS_URL=http://auth.dploy.localhost/dex/keys
JWT_ISSUER=http://auth.dploy.localhost/dex
JWT_AUDIENCE=dploy
# Which claim names the owner of an environment. Dex's static password DB fills
# `name`; Keycloak and Authentik fill `preferred_username`.
JWT_USERNAME_CLAIM=name

# Kubernetes: namespace holding the DployTemplate and DployInstanceClaim objects
DPLOY_NAMESPACE=dploy-system

# JWT claims copied into a DployInstanceClaim's spec.params, where value
# templates see them as .Params. Everything else in the token stops at
# the API server — the operator never sees a raw token.
FORWARDED_CLAIMS=sub,preferred_username,email,name,groups

# Shown in the UI. The quota and TTLs the operator ENFORCES come from
# OperatorConfig.defaults (or a template's own override).
MAX_ENVIRONMENTS_PER_USER=5
DEFAULT_TTL=86400  # 24 hours in seconds
EXTEND_TTL=7200    # 2 hours in seconds

# UI feature flags. When false the nav link is hidden AND the matching endpoint
# is unregistered (404), so turning one off removes the capability, not just the
# button.
CATALOG_ENABLED=true
INSTANCES_LIST_ENABLED=true
MANAGER_ENABLED=true

# Who sees the Manager (cluster-wide admin) view, matched against the JWT.
# Dex static passwords cannot carry a groups claim, so dev matches on email.
ADMIN_CLAIM=email
ADMIN_VALUE=admin@dploy.localhost

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Debug (optional)
DEBUG=false  # Set to true to enable verbose debug logging

# OIDC (optional, for SSO login). Defaults to JWT_ISSUER when unset.
OIDC_ISSUER=http://auth.dploy.localhost/dex
# Only for split-horizon setups where the IdP has a distinct in-cluster URL and
# public URL. The dev cluster uses one URL for both (a CoreDNS rewrite sends the
# public hostname to the ingress controller in-cluster), so this stays unset.
# OIDC_PUBLIC_ISSUER=
OIDC_CLIENT_ID=dploy
OIDC_CLIENT_SECRET=dploy-secret
OIDC_REDIRECT_URL=http://dploy.localhost/auth/callback
OIDC_SCOPES=openid,profile,email
